---
/**
 * AI Router — circuit breakers, global kill switch, and recent routed requests.
 *
 * Thin Astro shell over the `<AiRouterConsole>` React island.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AiRouterConsole } from "@/components/dashboard";
---

<BaseLayout
  title="AI Router"
  description="Manage AI Router circuit breakers, the global kill switch, and review recent routed AI requests."
>
  <main class="container mx-auto flex max-w-6xl flex-col gap-8 px-4 py-12">
    <a
      href="/dashboard/guardian"
      class="font-mono text-[10px] uppercase tracking-[0.25em] text-muted-foreground hover:text-foreground"
    >
      ← Core Guardian
    </a>
    <AiRouterConsole client:load />
  </main>
</BaseLayout>
